# Loaded by `vite build --mode e2e` for the Playwright smoke suite. The hosts
# do not exist: e2e/mock-api.js answers every request to them inside the
# browser, so the suite needs no running service and no network.
VITE_USERS_BASE_URL=http://users.buster.test
VITE_BRACKETS_BASE_URL=http://brackets.buster.test
VITE_STRIPE_PUB_KEY=stub-stripe-key-see-mock-api
